NODE_ENV=development
PORT=5000
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.6-27b
# Google Cloud reCAPTCHA Enterprise. Leave blank in local development to use the safe mock CAPTCHA flow.
RECAPTCHA_ENTERPRISE_PROJECT_ID=your_gcp_project_id
RECAPTCHA_ENTERPRISE_API_KEY=your_recaptcha_enterprise_api_key
RECAPTCHA_ENTERPRISE_SITE_KEY=your_recaptcha_site_key
# Comma-separated browser origins. Do not use * for this protected API.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://sgp-scholarship.pages.dev
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
# SGP Admin Recipient Email (optional, defaults to EMAIL_USER if not set)
REPORT_RECIPIENT_EMAIL=your_admin_recipient_email@gmail.com
