# HTTPS backend URL for production. Leave unset to use localhost:5000 in development.
REACT_APP_API_URL=http://localhost:5000
# Public reCAPTCHA Enterprise checkbox site key. Leave blank in local development to use the safe mock CAPTCHA flow.
REACT_APP_RECAPTCHA_ENTERPRISE_SITE_KEY=your_recaptcha_enterprise_site_key_here

