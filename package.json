{
  "name": "scholarship-portal",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "pdfjs-dist": "6.3.289",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "^6.28.0",
    "react-router-dom": "^6.28.0",
    "react-scripts": "^5.0.1",
    "tesseract.js": "^7.0.0",
    "web-vitals": "^2.1.4",
    "xml2js": "^0.6.2"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "set GENERATE_SOURCEMAP=false&& react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "postinstall": "node -e \"const fs=require('fs'); const path=require('path'); const src='node_modules/pdfjs-dist/build/pdf.worker.min.mjs'; const dest='public/pdfjs/pdf.worker.min.mjs'; fs.mkdirSync(path.dirname(dest), {recursive:true}); if (fs.existsSync(src)) { if (!fs.existsSync(dest) || fs.statSync(src).mtimeMs > fs.statSync(dest).mtimeMs) { fs.copyFileSync(src, dest); } }\""
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
